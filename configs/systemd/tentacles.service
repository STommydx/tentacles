# Production supervisor: root manages system units and transfers fresh slots
# to the configured unprivileged runner account. Keep config, template, cache,
# and JIT source files owned by root; never grant runners writes to them.
# Leave User= and Group= unset: root is the system-service default, and the
# hardened service must retain capabilities for runner credential switches.
# Job services are independent transient units and survive supervisor restart.
[Unit]
Description=GitHub Actions host runner supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/sbin/tentacles --config /etc/tentacles/config.yaml
Restart=on-failure
RestartSec=5
# Initial verified payload download and boot adoption precede readiness.
TimeoutStartSec=15min
TimeoutStopSec=2min
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=tentacles
StateDirectoryMode=0755
CacheDirectory=tentacles
CacheDirectoryMode=0755
LogsDirectory=tentacles
LogsDirectoryMode=0750
RuntimeDirectory=tentacles
RuntimeDirectoryMode=0700
# Preserve JIT sources if an in-flight runner must be adopted after restart.
RuntimeDirectoryPreserve=yes
# The daemon creates the runner's shared caches (runner.shared_cache_paths,
# resolved against the runner env HOME) via a credential-dropped mkdir, so the
# supervisor needs write access to them. Provision these locations before boot;
# extend this list whenever shared_cache_paths grows beyond the default.
ReadWritePaths=-/home/gha-runner/.cache -/home/gha-runner/.local/share/mise -/home/gha-runner/go/pkg/mod

[Install]
WantedBy=multi-user.target
